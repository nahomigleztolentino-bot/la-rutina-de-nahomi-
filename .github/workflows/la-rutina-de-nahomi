<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La rutina de Nahomi</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;background:#fff0f6;color:#70445b;font-family:Arial,sans-serif}
main{max-width:520px;margin:auto}
header{text-align:center;background:#ffd6e8;padding:24px;border-radius:24px}
h1{color:#a83d75;margin:8px 0}
.card{background:#fff;border-radius:18px;padding:16px;margin:14px 0;box-shadow:0 3px 12px #e9b6d055}
h2{color:#c05b91}
.task{display:flex;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid #ffe3ef}
input[type=checkbox]{accent-color:#df78aa;width:19px;height:19px}
button{background:#e78db8;color:white;border:0;border-radius:14px;padding:12px;font-size:15px;cursor:pointer}
input[type=text]{padding:12px;border:1px solid #f2c1d8;border-radius:12px;width:68%;font-size:15px}
#progress{font-weight:bold;color:#b44580}
footer{text-align:center;padding:15px;color:#b56b91}
</style>
</head>
<body>
<main>
<header>
<div style="font-size:35px">🎀 🧸 🍓</div>
<h1>La rutina de Nahomi</h1>
<p>Un día bonito, a mi propio ritmo 💗</p>
<div id="fecha"></div>
</header>
<section class="card">
<h2>🌸 Mi rutina de hoy</h2>
<div id="tasks"></div>
<p id="progress">0 tareas completadas</p>
</section>
<section class="card">
<h2>💌 Agregar una tarea</h2>
<input id="newTask" type="text" placeholder="Mi nueva tarea...">
<button id="add">Añadir +</button>
</section>
<section class="card" style="text-align:center">
<h2>💖 Frase bonita</h2>
<p id="quote">Cada pequeño paso cuenta. ¡Tú puedes! 🌷</p>
<button id="change">Otra frase ✨</button>
</section>
<footer>Hecho con amor para Nahomi 💗 🍓</footer>
</main>
<script>
const defaults=['Despertar y tender mi cama','Lavarse la carita 🫧','Desayunar rico 🍓','Ordenar mi espacio 🧸','Dedicar tiempo a mis estudios 📚','Prepararme para dormir 🌙'];
let tasks=JSON.parse(localStorage.getItem('nahomiTasks')||'null')||defaults.map(t=>({text:t,done:false}));
const quotes=['Eres capaz de lograr cosas bonitas 🌸','Descansar también es cuidarte 🧸','No tienes que hacerlo todo perfecto 💗','Hoy puedes empezar de nuevo 🍓','Tu esfuerzo merece cariño 🎀'];
function save(){localStorage.setItem('nahomiTasks',JSON.stringify(tasks));render()}
function render(){
const root=document.getElementById('tasks');root.innerHTML='';
tasks.forEach((t,i)=>{
const row=document.createElement('label');row.className='task';
const cb=document.createElement('input');cb.type='checkbox';cb.checked=t.done;
cb.addEventListener('change',()=>{tasks[i].done=cb.checked;save()});
const span=document.createElement('span');span.textContent=t.text;
if(t.done)span.style.textDecoration='line-through';
row.append(cb,span);root.appendChild(row);
});
const n=tasks.filter(t=>t.done).length;
document.getElementById('progress').textContent=n+' de '+tasks.length+' tareas completadas 💕';
}
document.getElementById('add').addEventListener('click',()=>{
const input=document.getElementById('newTask');const value=input.value.trim();
if(value){tasks.push({text:value,done:false});input.value='';save()}
});
document.getElementById('change').addEventListener('click',()=>{
document.getElementById('quote').textContent=quotes[Math.floor(Math.random()*quotes.length)];
});
document.getElementById('fecha').textContent=new Date().toLocaleDateString('es-MX',{weekday:'long',day:'numeric',month:'long'});
render();
</script>
</body>
</html>
